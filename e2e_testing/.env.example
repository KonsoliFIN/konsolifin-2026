# =====================================================================
# KonsoliFIN E2E Testing - Ympäristömuuttujat / Environment Variables
# =====================================================================

# --- Staging-ympäristö (https://stage.konsolifin.net) ---
# Kohdeosoite staging-testeille
STAGING_BASE_URL=https://stage.konsolifin.net

# Staging-testikäyttäjän kirjautumistiedot
# Täytä nämä omaan .env-tiedostoosi, jotta staging-kirjautumistestit ajetaan
STAGING_USERNAME=
STAGING_PASSWORD=

# --- Paikallinen kehitysympäristö / Local Environment ---
# Oletusosoite paikalliselle ympäristölle (OrbStack: https://web.konsolifin.orb.local/)
# Docker Desktop / localhost: http://localhost:8080/
BASE_URL=https://web.konsolifin.orb.local/

# Paikallisen kehitysympäristön pääkäyttäjän tunnukset
LOCAL_USERNAME=admin
LOCAL_PASSWORD=admin
