<div id="konsolifin-interstitial-modal" class="konsolifin-interstitial-overlay" style="display: none;">
  <div class="konsolifin-interstitial-content">
    <div class="konsolifin-interstitial-top-bar">
      <button id="konsolifin-interstitial-unmute" class="konsolifin-interstitial-btn konsolifin-interstitial-unmute-btn" aria-label="Kytke äänet (Unmute)">
        <span class="icon">🔇</span> <span class="label">Kytke äänet (Unmute)</span>
      </button>
      <button id="konsolifin-interstitial-close" class="konsolifin-interstitial-btn konsolifin-interstitial-close-btn" aria-label="Sulje (Close)">&times; Sulje (Close)</button>
    </div>
    <div class="konsolifin-interstitial-video-wrapper">
      <iframe data-src="{{ youtube_embed_url }}{% if '?' in youtube_embed_url %}&{% else %}?{% endif %}autoplay=1&mute=1&playsinline=1&enablejsapi=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
  </div>
</div>
